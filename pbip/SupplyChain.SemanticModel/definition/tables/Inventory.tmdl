/// Weekly (Sunday) stock snapshot per product x warehouse (semi-additive: use the Stock measures, never SUM over dates).
table Inventory
	lineageTag: b14d4d42-044a-53c0-93d3-5d2882ae3e28

	column 'Snapshot Date'
		dataType: dateTime
		lineageTag: 8aa24d41-b4eb-51c4-ac73-51f1cd7e390a
		summarizeBy: none
		sourceColumn: Snapshot Date

		annotation SummarizationSetBy = Automatic

	column 'Product ID'
		dataType: string
		isHidden
		lineageTag: 8a236870-aa13-5458-9850-9eb02c151dc3
		summarizeBy: none
		sourceColumn: Product ID

		annotation SummarizationSetBy = Automatic

	column 'Warehouse ID'
		dataType: string
		isHidden
		lineageTag: 7ab9b387-d073-5e37-937d-ef719dc8bc28
		summarizeBy: none
		sourceColumn: Warehouse ID

		annotation SummarizationSetBy = Automatic

	column 'Stock Quantity'
		dataType: int64
		lineageTag: 1f550dd2-dee2-54bf-823a-5bac1f9e182d
		summarizeBy: none
		sourceColumn: Stock Quantity

		annotation SummarizationSetBy = Automatic

	column 'Reserved Qty'
		dataType: int64
		lineageTag: b68403ad-69ff-5b64-94e2-d171a377697c
		summarizeBy: none
		sourceColumn: Reserved Qty

		annotation SummarizationSetBy = Automatic

	column 'Available Qty'
		dataType: int64
		lineageTag: bc08d66c-2d5f-537b-a2d1-ba1b6e22e4bc
		summarizeBy: none
		sourceColumn: Available Qty

		annotation SummarizationSetBy = Automatic

	column 'Is Stockout'
		dataType: int64
		lineageTag: 8366dd82-1cea-5db3-b052-925942688acd
		summarizeBy: none
		sourceColumn: Is Stockout

		annotation SummarizationSetBy = Automatic

	partition Inventory = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "inventory.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // culture en-US so '.' is always the decimal separator, whatever the PC's regional settings
				    Typed = Table.TransformColumnTypes(Promoted, {{"Snapshot_Date", type date}, {"Product_ID", type text}, {"Warehouse_ID", type text}, {"Stock_Quantity", Int64.Type}, {"Reserved_Qty", Int64.Type}}, "en-US"),
				    Renamed = Table.TransformColumnNames(Typed, each Text.Replace(_, "_", " ")),
				    AddAvail = Table.AddColumn(Renamed, "Available Qty", each [Stock Quantity] - [Reserved Qty], Int64.Type),
				    AddOOS = Table.AddColumn(AddAvail, "Is Stockout", each if [Stock Quantity] <= 0 then 1 else 0, Int64.Type)
				in
				    AddOOS

	annotation PBI_ResultType = Table
