	column 'Product Label'
		dataType: string
		lineageTag: 75dfa251-32d8-5a9d-ba1a-25d62981c41c
		summarizeBy: none
		sourceColumn: Product Label

		annotation SummarizationSetBy = Automatic

	column 'Unit Margin %'
		dataType: double
		formatString: 0.0%
		lineageTag: bb28ff0e-b2f7-5c50-9218-c72aa6c352ed
		summarizeBy: none
		sourceColumn: Unit Margin %

		annotation SummarizationSetBy = Automatic

	column Perishable
		dataType: string
		lineageTag: 6b2e7c8c-69fe-5bf5-8528-23a2779834c7
		summarizeBy: none
		sourceColumn: Perishable

		annotation SummarizationSetBy = Automatic

	/// Lifetime net sales of the product (ALLEXCEPT avoids a circular dependency with ABC Class)
	column 'Lifetime Net Sales' = CALCULATE ( SUM ( Sales[Net Sales] ), ALLEXCEPT ( 'Product', 'Product'[Product ID] ) )
		dataType: double
		formatString: ₹#,0
		isHidden
		lineageTag: e0043189-576b-52f6-9640-57f89560606e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// A = products making the first 80% of revenue, B = next 15%, C = last 5%
	column 'ABC Class' =
			VAR r = 'Product'[Lifetime Net Sales]
			VAR tot = SUM ( 'Product'[Lifetime Net Sales] )
			VAR cum = SUMX ( FILTER ( 'Product', 'Product'[Lifetime Net Sales] >= r ), 'Product'[Lifetime Net Sales] )
			VAR share = DIVIDE ( cum, tot )
			RETURN IF ( share <= 0.80, "A", IF ( share <= 0.95, "B", "C" ) )
		dataType: string
		lineageTag: 43df4cd3-42e6-5b0c-b892-8d5b751c72d7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Product' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "products.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty CSV cells in optional columns -> null before typing
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Shelf_Life_Days"}),
				    // culture en-US so '.' is always the decimal separator, whatever the PC's regional settings
				    Typed = Table.TransformColumnTypes(Blanks, {{"Product_ID", type text}, {"Product_Name", type text}, {"Category", type text}, {"Sub_Category", type text}, {"Unit_Cost", type number}, {"Unit_Price", type number}, {"Lead_Time_Days_Std", Int64.Type}, {"Reorder_Point", Int64.Type}, {"Safety_Stock", Int64.Type}, {"Shelf_Life_Days", Int64.Type}}, "en-US"),
				    Renamed = Table.TransformColumnNames(Typed, each Text.Replace(_, "_", " ")),
				    AddLabel = Table.AddColumn(Renamed, "Product Label", each [Product ID] & " - " & [Product Name], type text),
				    AddMargin = Table.AddColumn(AddLabel, "Unit Margin %", each if [Unit Price] = 0 then null else ([Unit Price] - [Unit Cost]) / [Unit Price], type number),
				    AddPerish = Table.AddColumn(AddMargin, "Perishable", each if [Shelf Life Days] = null then "Non-perishable" else "Perishable", type text)
				in
				    AddPerish

	annotation PBI_ResultType = Table
