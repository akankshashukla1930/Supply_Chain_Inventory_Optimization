/// Product master (400 SKUs, 8 categories). ABC Class is a DAX calculated column (lifetime net sales, 80/15/5 split).
table 'Product'
	lineageTag: 1afa1a6a-84ce-5004-843b-448e67a01ec6

	column 'Product ID'
		dataType: string
		lineageTag: 3e8d1207-6078-518f-9171-aa139daa9d35
		summarizeBy: none
		sourceColumn: Product ID

		annotation SummarizationSetBy = Automatic

	column 'Product Name'
		dataType: string
		lineageTag: 96950237-1fca-5c86-8704-083999cca201
		summarizeBy: none
		sourceColumn: Product Name

		annotation SummarizationSetBy = Automatic

	column Category
		dataType: string
		lineageTag: 54483b2f-853a-5ba4-bd2b-0cb0065faf1c
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

	column 'Sub Category'
		dataType: string
		lineageTag: 20005970-07dd-5a73-b57e-9b264e4455b8
		summarizeBy: none
		sourceColumn: Sub Category

		annotation SummarizationSetBy = Automatic

	column 'Unit Cost'
		dataType: double
		formatString: ₹#,0.00
		lineageTag: 94ccf813-482f-589d-ac12-875940011966
		summarizeBy: none
		sourceColumn: Unit Cost

		annotation SummarizationSetBy = Automatic

	column 'Unit Price'
		dataType: double
		formatString: ₹#,0.00
		lineageTag: 18a9e8fc-747b-5edf-a321-aa9ef37e6507
		summarizeBy: none
		sourceColumn: Unit Price

		annotation SummarizationSetBy = Automatic

	column 'Lead Time Days Std'
		dataType: int64
		lineageTag: 4f4dff1f-4e0b-5748-b899-9ac126103226
		summarizeBy: none
		sourceColumn: Lead Time Days Std

		annotation SummarizationSetBy = Automatic

	column 'Reorder Point'
		dataType: int64
		lineageTag: c3780c50-f4f4-5389-8097-d971ad93d257
		summarizeBy: none
		sourceColumn: Reorder Point

		annotation SummarizationSetBy = Automatic

	column 'Safety Stock'
		dataType: int64
		lineageTag: e2e406db-7218-5dc8-b18d-40ef8a79d193
		summarizeBy: none
		sourceColumn: Safety Stock

		annotation SummarizationSetBy = Automatic

	column 'Shelf Life Days'
		dataType: int64
		lineageTag: 6d801458-e98e-5df7-b409-226c8f774163
		summarizeBy: none
		sourceColumn: Shelf Life Days

