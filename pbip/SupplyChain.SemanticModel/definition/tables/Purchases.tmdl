/// Purchase-order lines (~22k). Active date relationship = PO Date; inactive = Actual Delivery Date (used for receipts).
table Purchases
	lineageTag: 7af83661-b688-5f39-8725-843310d33393

	column 'Purchase ID'
		dataType: string
		lineageTag: c9b06851-33ea-5dad-8786-3bee0fcbb70f
		summarizeBy: none
		sourceColumn: Purchase ID

		annotation SummarizationSetBy = Automatic

	column 'PO Date'
		dataType: dateTime
		lineageTag: 4ec009e8-5cf4-523c-ac30-e33ed981b9c5
		summarizeBy: none
		sourceColumn: PO Date

		annotation SummarizationSetBy = Automatic

	column 'Supplier ID'
